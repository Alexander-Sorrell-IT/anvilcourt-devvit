{
  "private": true,
  "name": "anvilcourt",
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "description": "Anvil Court — case-law engine for Reddit moderation: every removal becomes precedent; every appeal renders the rule's track record; mods rule with context, not memory (Devvit).",
  "scripts": {
    "build": "node --experimental-strip-types ./tools/build.ts --minify",
    "deploy": "npm run build && devvit upload",
    "dev": "devvit playtest",
    "login": "devvit login",
    "launch": "npm run build && npm run deploy && devvit publish",
    "type-check": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node --experimental-strip-types ./tools/seed-demo.ts"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "@devvit/web": "0.12.24",
    "devvit": "0.12.24"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "esbuild": "0.28.0",
    "playwright": "^1.61.0",
    "typescript": "6.0.3",
    "vitest": "^2.1.8"
  }
}
