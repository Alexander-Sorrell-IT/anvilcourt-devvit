{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "grantscribe",
  "server": {
    "dir": "dist/server",
    "entry": "index.js"
  },
  "menu": {
    "items": [
      {
        "label": "Receipts: look up user",
        "description": "Show a user's removal + appeal history",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/lookup-user"
      },
      {
        "label": "Receipts: recent removals",
        "description": "Show the most recent logged removals",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/recent-log"
      }
    ]
  },
  "forms": {
    "lookupUser": "/internal/form/lookup-user"
  },
  "triggers": {
    "onAppInstall": "/internal/on-app-install",
    "onModAction": "/internal/triggers/mod-action",
    "onAutomoderatorFilterPost": "/internal/triggers/automod-filter-post",
    "onAutomoderatorFilterComment": "/internal/triggers/automod-filter-comment",
    "onModMail": "/internal/triggers/modmail"
  },
  "permissions": {
    "reddit": {
      "enable": true,
      "scope": "moderator"
    },
    "redis": true
  },
  "scripts": {
    "dev": "node --experimental-strip-types ./tools/build.ts --watch",
    "build": "node --experimental-strip-types ./tools/build.ts --minify"
  },
  "dev": {
    "subreddit": "alexander_sorrell_IT"
  }
}
